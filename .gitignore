# Dependencies
node_modules/

# Runtime artifacts a consumer creates locally — never part of the Factory source.
# (.sandcastle/*.ts, *.test.ts, tsconfig.json and package.json ARE tracked; only these
#  subpaths are not. The tracked .sandcastle/package.json is the self-contained ESM shim
#  — { "type": "module" } — so main.ts transpiles regardless of the consumer's root pkg.)
.sandcastle/.env
.sandcastle/.env.secrets
.sandcastle/logs/
.sandcastle/worktrees/
.sandcastle/publish-pending.json

# Local Claude settings (per-developer)
.claude/settings.local.json
